{
  "name": "finmatter",
  "version": "1.0.0",
  "description": "Personal finance super app for credit card optimization and AI-powered insights",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:pwa": "pnpm --filter web-pwa dev",
    "dev:api": "pnpm --filter api dev",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:pwa": "pnpm --filter web-pwa build",
    "build:api": "pnpm --filter api build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "db:link:staging": "supabase link --project-ref gzjlausszwdrrpyzdjwl",
    "db:link:prod": "supabase link --project-ref tpiemcfwrodnxbrvjsvx",
    "db:push:staging": "pnpm db:link:staging && supabase db push",
    "db:push:prod": "pnpm db:link:prod && supabase db push",
    "db:reset:staging": "pnpm db:link:staging && supabase db reset",
    "db:reset:prod": "pnpm db:link:prod && supabase db reset",
    "db:diff": "supabase db diff",
    "db:migration:new": "supabase migration new",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "upload:bank-logos": "tsx scripts/upload-bank-logos.ts",
    "upload:network-icons": "tsx scripts/upload-network-icons.ts",
    "add:network-logos": "tsx scripts/add-network-logos-to-cards.ts",
    "merge:card-data": "tsx scripts/merge-card-data.ts",
    "seed:database": "tsx scripts/seed-database.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.2.4",
    "supabase": "^2.58.5",
    "tsx": "^4.8.1",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "fintech",
    "personal-finance",
    "credit-cards",
    "ai",
    "pwa",
    "nextjs",
    "typescript"
  ],
  "author": "FinMatter Team",
  "license": "MIT"
}
