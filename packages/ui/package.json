{
  "name": "@finmatter/ui",
  "version": "1.0.0",
  "description": "Shared UI components for FinMatter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
